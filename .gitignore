# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code -- machine-local settings (hook registration, etc.), not shared
.claude/settings.local.json

# impeccable -- PRODUCT.md/DESIGN.md/config.json are shared design context and
# stay tracked; everything below is per-run working state or per-developer
# overrides
.impeccable/config.local.json
.impeccable/mocks/
.impeccable/build/
.impeccable/review/
.impeccable/critique/
.impeccable/design.json
